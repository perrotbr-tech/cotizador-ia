# Supabase. Las dos variables son publicas: viajan al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Buscador de precios. "simulado" responde desde fixtures, sin salir a internet.
# Valores: simulado | serpapi
BUSCADOR=simulado

# Modelo que lee la solicitud. Ningun identificador de modelo va escrito en el codigo.
MODELO_EXTRACTOR=

# Claves. Solo en el servidor. Nunca en el repositorio.
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=

# Topes de busqueda.
TOPE_BUSQUEDAS_DIA=100
TOPE_BUSQUEDAS_MES=240
